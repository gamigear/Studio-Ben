# Sao chép thành .env rồi điền giá trị.

# Chuỗi ngẫu nhiên dài, tạo bằng: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Khóa mã hóa API key AI lưu trong DB. Đặt một lần và KHÔNG đổi (đổi sẽ không đọc được các API key đã lưu).
FIELD_ENCRYPTION_KEY=
DEBUG=false

APP_URL=https://lenlich.tiepdi.com
ALLOWED_HOSTS=lenlich.tiepdi.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://lenlich.tiepdi.com

# Mật khẩu PostgreSQL trong docker compose
POSTGRES_PASSWORD=

# Token của Cloudflare Tunnel (Zero Trust → Networks → Tunnels), dùng khi chạy profile "tunnel"
CLOUDFLARE_TUNNEL_TOKEN=

# Chạy ngoài Docker:
# GOOGLE_SERVICE_ACCOUNT_FILE=/duong/dan/google-service-account.json
# DATABASE_URL=sqlite:///db.sqlite3

# Tùy chỉnh worker (giá trị mặc định)
# DRIVE_SYNC_INTERVAL=300      # số giây giữa các lần quét Drive
# SCHEDULE_DAYS_AHEAD=2        # xếp lịch trước bao nhiêu ngày
# MEDIA_RETENTION_DAYS=7       # giữ file video trên máy chủ bao nhiêu ngày sau khi đăng
# OVERDUE_GRACE_MINUTES=15     # quá bao nhiêu phút sau giờ hẹn thì tính là trễ
# CAPTION_MAX_ATTEMPTS=3       # số lần AI thử viết caption trước khi báo lỗi
